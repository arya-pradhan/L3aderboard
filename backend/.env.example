# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- Database (Neon Postgres) ---
# Locally, `neon deploy` / `neon env pull` writes both of these into the repo-root
# .env.local, which the backend reads automatically. Only set them here to override.
#   DATABASE_URL           pooled (-pooler) URL for app traffic
#   DATABASE_URL_UNPOOLED  direct URL, used by Alembic migrations
# Paste Neon's strings as-is; the app rewrites sslmode/channel_binding for asyncpg.
# Without either, the app falls back to a local SQLite file.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# --- JWT auth ---
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (comma-separated origins for the frontend) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the frontend lives; Steam login redirects back here with a token.
FRONTEND_URL=http://localhost:5173

# --- External APIs ---
RAWG_API_KEY=              # step 3 — https://rawg.io/apidocs
# STEAM_API_KEY=           # step 4 — https://steamcommunity.com/dev/apikey
#                          #   (only needed for library import; Steam sign-in works without it)
# DEEPSEEK_API_KEY=        # assistant chat — https://platform.deepseek.com/api_keys
# DEEPSEEK_MODEL=deepseek-flash
