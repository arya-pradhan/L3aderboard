# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- Database (Railway Postgres) ---
# Railway gives you a URL like: postgresql://user:pass@host:port/dbname
# The app auto-normalizes it to the async driver (postgresql+asyncpg://).
DATABASE_URL=postgresql://user:password@localhost:5432/gamerlog

# --- JWT auth ---
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (comma-separated origins for the frontend) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the frontend lives; Steam login redirects back here with a token.
FRONTEND_URL=http://localhost:5173

# --- External APIs ---
RAWG_API_KEY=              # step 3 — https://rawg.io/apidocs
# STEAM_API_KEY=           # step 4 — https://steamcommunity.com/dev/apikey
#                          #   (only needed for library import; Steam sign-in works without it)
# OPENAI_API_KEY=          # stretch — https://platform.openai.com/api-keys
